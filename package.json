{
  "name": "comark-loops",
  "version": "0.1.0",
  "description": "Framework-agnostic Comark ::for plugin with scoped bindings and nested loops",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "git+https://github.com/xMrAfonso/comark-loops.git" },
  "homepage": "https://github.com/xMrAfonso/comark-loops#readme",
  "bugs": { "url": "https://github.com/xMrAfonso/comark-loops/issues" },
  "keywords": ["comark", "comark-plugin", "markdown", "loops"],
  "packageManager": "pnpm@10.34.6",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" }
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:coverage": "pnpm run build && node --test --experimental-test-coverage --test-coverage-include='dist/*.js' tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm test",
    "prepare": "pnpm run build",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "comark": "^0.7.0"
  },
  "devDependencies": {
    "@comark/html": "0.7.0",
    "comark": "0.7.0",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=20.19.0" }
}
